# Backend settings. Copy this file to .env and fill in your own values.
# .env is read automatically by `npm run dev`, `npm start`, `npm test` and `npm run reset-login`.
# Never commit .env: it is listed in .gitignore.

# ---- Server ----
PORT=4000

# ---- Database ----
# MongoDB connection string. For MongoDB Atlas or a password-protected server it holds the
# user name and password, e.g. mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/gymsoft
MONGO_URL=mongodb://127.0.0.1:27017/gymsoft
# Databases used by the tests; they are wiped on every test run, so never point them at real data.
MONGO_TEST_URL=mongodb://127.0.0.1:27017/gymsoft_test
MONGO_TEST_WA_URL=mongodb://127.0.0.1:27017/gymsoft_test_wa

# ---- Website on another address ----
# Leave empty when this server also serves the website (the usual setup).
# If the website is hosted elsewhere, list its addresses, comma-separated, e.g.
# CORS_ORIGINS=https://gymsolution.in,https://www.gymsolution.in
CORS_ORIGINS=

# ---- WhatsApp reminders (see src/whatsapp/config.js) ----
# Reminders are sent only between these hours (server time, 24-hour clock).
WHATSAPP_SEND_FROM_HOUR=8
WHATSAPP_SEND_UNTIL_HOUR=21
# Safety limits so the gym number is not flagged as a bulk sender.
WHATSAPP_MAX_PER_DAY=40
WHATSAPP_MAX_PER_HOUR=10
# How often (seconds) the server looks for reminders to send.
WHATSAPP_JOB_INTERVAL_SEC=300
# Connection timings (seconds).
WHATSAPP_IDLE_CLOSE_SEC=60
WHATSAPP_LAUNCH_TIMEOUT_SEC=90
WHATSAPP_SEND_WAIT_READY_SEC=180
WHATSAPP_WATCHDOG_SEC=60
WHATSAPP_QR_IDLE_SEC=90
WHATSAPP_QR_MAX_SEC=300
